# Parco custom proxy rules
# These rules use the Parco Proxy group in the client configurations.

DOMAIN-SUFFIX,photomath.net

# Existing Meta AI rule, retained. Also covers Muse's agent/chat endpoints.
DOMAIN-SUFFIX,meta.ai

# Muse: verified from the public website, shipped JavaScript and CSP, 2026-09-25.
# Suffix rules cover the apex and all current/future subdomains, including
# auth.muse.ai, api.muse.ai, introducing.muse.ai and security.muse.ai.
DOMAIN-SUFFIX,muse.ai

# Related origins in Muse's shipped origin configuration; some require staff SSO.
# Covers production.museai.com, voice.museai.com and hatch.ecto1.ai.
DOMAIN-SUFFIX,museai.com
DOMAIN-SUFFIX,ecto1.ai
DOMAIN-SUFFIX,hatch.club

# Generated content / isolated app hosts (some are conditional CSP dependencies).
DOMAIN-SUFFIX,metaaiusercontent.com
DOMAIN-SUFFIX,ecto1usercontent.com
DOMAIN-SUFFIX,meta-agents-apps.workers.dev

# Exact Meta OHTTP service hosts; do not match all Fastly domains.
DOMAIN,meta-ohttp-config-prod.fastly-edge.com
DOMAIN,meta-ohttp-relay-prod.fastly-edge.com

# Shared sign-in, recovery and help hosts referenced by Muse.
# These hosts may also carry traffic for other Meta products.
DOMAIN-SUFFIX,auth.meta.com
DOMAIN,www.facebook.com
DOMAIN,web.facebook.com
DOMAIN,www.instagram.com
DOMAIN,www.meta.com
DOMAIN,fb.okta.com

# Shared media/CDN families allowed by Muse's CSP; not Muse-exclusive.
DOMAIN-SUFFIX,fbcdn.net
DOMAIN-SUFFIX,fbsbx.com
DOMAIN-SUFFIX,cdninstagram.com
DOMAIN-SUFFIX,cdn.whatsapp.net
DOMAIN-SUFFIX,oculuscdn.com

# Optional checkout dependencies referenced by Muse's code / CSP.
DOMAIN,js.stripe.com
DOMAIN,api.stripe.com
DOMAIN,hooks.stripe.com
DOMAIN,m.stripe.network
DOMAIN-SUFFIX,link.com

# Optional fonts, diagnostics and analytics referenced by the public app.
DOMAIN,fonts.googleapis.com
DOMAIN,fonts.gstatic.com
DOMAIN,o4509963614355457.ingest.us.sentry.io
DOMAIN,connect.facebook.net
DOMAIN,va.vercel-scripts.com

# Observed IP fallback, 2026-09-25; explicitly enabled by the user.
# Exact /32 and /128 addresses only. Shared hosting can match other services.
# no-resolve skips an extra DNS lookup; it does NOT make shared IPs exclusive.
# Addresses are a snapshot and can change. See muse-ip-observations.json.
